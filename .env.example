API_HOST=127.0.0.1
API_PORT=18787
DATA_DIR=./data

# 图片：任意 OpenAI 兼容网关（/images/generations；有参考图走 /images/edits）
# 旧名 OPENAI_API_KEY / OPENAI_BASE_URL 仍可作为回退
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=high

# 分镜 LLM：国产 OpenAI 兼容网关
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=json_schema

# 视频：火山方舟
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_SEEDANCE_20=doubao-seedance-2-0-260128
ARK_MODEL_SEEDANCE_20_FAST=doubao-seedance-2-0-fast-260128
ARK_MODEL_SEEDANCE_20_MINI=doubao-seedance-2-0-mini-260615
ARK_MODEL_SEEDANCE_25=doubao-seedance-2-5-260628
# 真人模型（需配合下方 ARK_ASSET_AK/SK 使用）
ARK_MODEL_SEEDANCE_20_REAL=doubao-seedance-2-0-real
ARK_MODEL_SEEDANCE_20_FAST_REAL=doubao-seedance-2-0-fast-260128
ARK_MODEL_SEEDANCE_20_MINI_REAL=doubao-seedance-2-0-mini-260615
ARK_MODEL_SEEDANCE_25_REAL=doubao-seedance-2-5-real
VIDEO_PROVIDER=ark_seedance
DEFAULT_VIDEO_MODEL=seedance-2.0
ATTACH_PREV_VIDEO=0

# 火山素材库（真人参考图审核，仅 seedance-*-real 模型需要）
# 官方文档: https://www.volcengine.com/docs/82379/2333565
# AK/SK 与方舟 API Key 不同，需在火山控制台 → IAM 访问密钥获取
ARK_ASSET_AK=
ARK_ASSET_SK=
ARK_ASSET_REGION=cn-beijing
ARK_ASSET_SERVICE=ark
ARK_ASSET_BASE_URL=https://ark.cn-beijing.volcengineapi.com
ARK_ASSET_API_VERSION=2024-01-01
# 素材组 ID（留空则首次提交时自动创建）
ARK_ASSET_GROUP_ID=
ARK_ASSET_PROJECT_NAME=default
ARK_ASSET_GROUP_NAME=voiceover-private-avatar
# 审核轮询超时和间隔（毫秒）
ARK_ASSET_POLL_TIMEOUT_MS=30000
ARK_ASSET_POLL_INTERVAL_MS=5000
# 阿里云 OSS（必需：真人参考图公网 URL 来源，无需暴露本服务到公网）
# 火山素材库 CreateAsset 只接受公网 HTTP(S) URL，本地图片一律先上传 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
# 公开访问域名（bucket 公读或 CDN，如 https://cdn.example.com）
OSS_PUBLIC_BASE_URL=
# 可选：自定义 endpoint / 对象 key 前缀
# OSS_ENDPOINT=
# OSS_PREFIX=voiceover

# 视频：MiniMax / Hailuo（视频生成模型 MiniMax-H3）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-H3

FEATURE_IMAGE_GEN=0
FEATURE_VIDEO_GEN=0
LEASE_SEC=60
MAX_GENERATION_SECONDS_PER_DAY=600
