API_HOST=127.0.0.1
API_PORT=18787
DATA_DIR=./data

# LLM、图片、Seedance、MiniMax 配置请在应用的「设置 → 模型设置」中填写。
# 升级已有安装时，旧 .env 中的模型配置会在首次启动时自动导入一次。

# 火山素材库（真人参考图审核，仅 seedance-*-real 模型需要）
# 官方文档: https://www.volcengine.com/docs/82379/2333565
# AK/SK 与方舟 API Key 不同，需在火山控制台 → IAM 访问密钥获取
ARK_ASSET_AK=
ARK_ASSET_SK=
ARK_ASSET_REGION=cn-beijing
ARK_ASSET_SERVICE=ark
ARK_ASSET_BASE_URL=https://ark.cn-beijing.volcengineapi.com
ARK_ASSET_API_VERSION=2024-01-01
# 素材组 ID（留空则首次提交时自动创建）
ARK_ASSET_GROUP_ID=
ARK_ASSET_PROJECT_NAME=default
ARK_ASSET_GROUP_NAME=voiceover-private-avatar
# 审核轮询超时和间隔（毫秒）
ARK_ASSET_POLL_TIMEOUT_MS=30000
ARK_ASSET_POLL_INTERVAL_MS=5000
# 阿里云 OSS（必需：真人参考图公网 URL 来源，无需暴露本服务到公网）
# 火山素材库 CreateAsset 只接受公网 HTTP(S) URL，本地图片一律先上传 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-beijing
OSS_BUCKET=
# 公开访问域名（bucket 公读或 CDN，如 https://cdn.example.com）
OSS_PUBLIC_BASE_URL=
# 可选：自定义 endpoint / 对象 key 前缀
# OSS_ENDPOINT=
# OSS_PREFIX=voiceover

LEASE_SEC=60
MAX_GENERATION_SECONDS_PER_DAY=600
